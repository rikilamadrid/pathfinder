.DS_Store
__MACOSX/
._*

# Destination-project generated learning/prototype output may be ignored locally if desired.
# prototypes/
# learning/

# Local planning only — not pushed
.features/

# Docs site. Dependencies and build output only — `site/package-lock.json` is
# committed so the pinned toolchain is reproducible. `site/public/favicon*` is
# generated by `site/scripts/sync-brand.mjs` from the single copy in `assets/`.
/site/node_modules/
/site/dist/
/site/.astro/
/site/public/favicon.svg
/site/public/favicon-32.png

# Transient. `npm pack` stages the kit into the installer package so npm can
# see it — `files` cannot reach outside the package directory — and unstages it
# afterwards. The copy at the repository root stays the only one in version
# control. Paths are anchored so the root context/, skills/, etc. are unaffected.
/packages/create-pathfinder/AGENTS.md
/packages/create-pathfinder/CLAUDE.md
/packages/create-pathfinder/LICENSE
/packages/create-pathfinder/context/
/packages/create-pathfinder/prompts/
/packages/create-pathfinder/skills/
/packages/create-pathfinder/templates/
/packages/create-pathfinder/*.tgz
